# ---- Sarvam AI ----
# SERVER-SIDE ONLY. Never expose this to the browser. The old TGBH repo shipped it
# as NEXT_PUBLIC_SARVAM_API_SUBSCRIPTION_KEY, which served the key to every visitor.
SARVAM_API_KEY=sk_xxx

# ---- Web retrieval (Tier B — context only, never cited) ----
# Optional. Without it HAQ simply has no background context for grievances outside
# the twelve verified snippets in data/statutes.json; nothing else changes.
# Retrieval is restricted to government domains (see sources.GOV_DOMAINS).
FIRECRAWL_API_KEY=

# ---- Demo mode ----
# live   | call Sarvam, cache nothing
# record | call Sarvam and write responses to data/cache/  (run this locally)
# replay | read from data/cache/, never touch the network  (use this on stage)
HAQ_MODE=live

# ---- Database ----
# Railway's container filesystem is EPHEMERAL. Attach a volume and point this at it,
# or every redeploy wipes live cases mid-demo.
HAQ_DB=./haq.db
# HAQ_DB=/data/haq.db     # <- on Railway, with a volume mounted at /data

# ---- WhatsApp channel (Meta Cloud API) ----
# 0 = module never imported. This is the PRD's "cut #1" as a single character.
CHANNEL_WHATSAPP=0
# Webhook verify token — you choose any random string; set the same in the Meta dashboard
VERIFY_TOKEN=change-me-random-string
# Meta App > Settings > Basic — used to verify inbound webhook signatures
APP_SECRET=your_meta_app_secret
# Permanent access token for the WhatsApp Business number
WA_TOKEN=your_permanent_wa_token
# WhatsApp Business phone number id (NOT the phone number itself)
PHONE_NUMBER_ID=your_phone_number_id

# ---- Server ----
PORT=8000
